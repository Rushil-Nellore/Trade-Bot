# Copy this file to .env and fill in your real values.
# DO NOT commit .env to git (it's already in .gitignore).
#
# Get free testnet API keys from: https://testnet.binance.vision/
# (Click "Generate HMAC_SHA256 Key" — you'll get a key + secret pair.)
#
# Then load into your shell:
#   PowerShell:  Get-Content .env | ForEach-Object { $name, $value = $_.split('='); [Environment]::SetEnvironmentVariable($name, $value, 'Process') }
#   Bash:        export $(grep -v '^#' .env | xargs)

BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here

# DO NOT set this to 1 unless you want REAL MONEY trading.
# When set to 1, you can pass --live to live.py to use the production exchange.
# BINANCE_LIVE=1
